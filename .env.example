# YOUTUBE_API_KEY: Chave da YouTube Data API v3 (mantida apenas no servidor).
# Configure no .env local ou nas variáveis de ambiente / Secrets do projeto.
YOUTUBE_API_KEY=""

# GEMINI_API_KEY: Opcional (variável padrão do ambiente AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública onde a aplicação está hospedada.
APP_URL="MY_APP_URL"
