# YOUTUBE_API_KEY: Chave da YouTube Data API v3 (mantida apenas no servidor).
# Opcional: sem ela, o app usa automaticamente os feeds oficiais dos canais verificados.
YOUTUBE_API_KEY=""

# GEMINI_API_KEY: Variável padrão do ambiente AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública onde a aplicação está hospedada.
APP_URL="MY_APP_URL"
